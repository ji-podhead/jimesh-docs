{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JiMeshPluginManifest",
  "type": "object",
  "required": ["id", "name", "version", "surfaces", "authSupported"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "surfaces": {
      "type": "array",
      "items": { "type": "string", "enum": ["iframe", "native", "widget", "mcp", "api", "chat"] }
    },
    "authSupported": {
      "type": "array",
      "items": { "type": "string", "enum": ["api_key", "service_account", "github_app"] }
    }
  }
}
