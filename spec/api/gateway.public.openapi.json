{
  "components": {
    "securitySchemes": {
      "consumerKey": {
        "description": "Project/service consumer key (Authorization: Bearer jimesh-ck-…).",
        "scheme": "bearer",
        "type": "http"
      },
      "embedToken": {
        "description": "Keycloak JWT, dashboard session, or handoff ?token= for embedded dashboards.",
        "in": "query",
        "name": "token",
        "type": "apiKey"
      },
      "gatewayKey": {
        "description": "Gateway API key (Authorization: Bearer jimesh-sk-…). Required only when the gateway auth setting is enabled; /v1/models is always open.",
        "scheme": "bearer",
        "type": "http"
      },
      "sessionBearer": {
        "description": "Dashboard session token or Keycloak JWT in Authorization: Bearer \u003ctoken\u003e.",
        "scheme": "bearer",
        "type": "http"
      },
      "sessionCookie": {
        "description": "Dashboard session cookie (set by POST /api/auth/login). Mutating cookie calls additionally need the jimesh_csrf double-submit header.",
        "in": "cookie",
        "name": "__Host-jimesh_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "HTTP surface of the JiMesh Go gateway: OpenAI-compatible model routing\n(`/v1/*`), the operator/dashboard API (`/api/*`), session auth, the SDK\nsurface for service keys, and liveness/readiness probes.\n\n**Scope of this document:** the public subset — everything an external\nclient (Claude Code, Cursor, scripts, SDKs) needs. The full internal\noperator surface ships as a separate, non-published spec.\n\nAuthentication per operation is declared in `security`; see the scheme\ndescriptions in `components.securitySchemes`.\n",
    "title": "JiMesh Gateway API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
